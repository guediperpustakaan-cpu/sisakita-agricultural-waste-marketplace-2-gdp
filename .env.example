# Salin file ini menjadi .env (lokal) atau set di Vercel Project Settings > Environment Variables.
# Jangan pernah commit .env yang berisi kredensial asli.

# Wajib — koneksi Neon/PostgreSQL (dari dashboard Neon: Connection string / pooled)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Disarankan — rahasia untuk menandatangani cookie session (gunakan nilai acak panjang)
AUTH_SECRET=ganti-dengan-secret-acak-yang-panjang
